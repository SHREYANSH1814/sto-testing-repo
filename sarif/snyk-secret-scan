  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Snyk Code",
          "version": "1.1292.0",
          "informationUri": "https://snyk.io",
          "rules": [
            {
              "id": "hardcoded-credentials-001",
              "shortDescription": {
                "text": "Hard-coded credentials found in source code"
              },
              "fullDescription": {
                "text": "The application contains hard-coded credentials that could allow unauthorized access if the source code is exposed."
              },
              "help": {
                "text": "Do not hard-code credentials in source code. Use environment variables or a secret manager."
              },
              "properties": {
                "tags": ["security", "secret"],
                "cwe": ["CWE-798"]
              }
            },
            {
              "id": "hardcoded-password-002",
              "shortDescription": {
                "text": "Hard-coded password in application configuration"
              },
              "fullDescription": {
                "text": "A password value is directly embedded in the source code instead of being retrieved from a secure vault or environment variable."
              },
              "help": {
                "text": "Remove hard-coded passwords and use a secrets management solution."
              },
              "properties": {
                "tags": ["security", "secret"],
                "cwe": ["CWE-259"]
              }
            },
            {
              "id": "hardcoded-crypto-key-003",
              "shortDescription": {
                "text": "Hard-coded cryptographic key detected"
              },
              "fullDescription": {
                "text": "A cryptographic key is hard-coded in the source, compromising the security of encrypted data if the code is leaked."
              },
              "help": {
                "text": "Use a key management service (KMS) to store and retrieve cryptographic keys."
              },
              "properties": {
                "tags": ["security", "secret"],
                "cwe": ["CWE-321"]
              }
            },
            {
              "id": "password-in-config-file-004",
              "shortDescription": {
                "text": "Password stored in configuration file"
              },
              "fullDescription": {
                "text": "A plaintext password was found in a configuration file that may be accessible to unauthorized users."
              },
              "help": {
                "text": "Store passwords in encrypted vaults, not in plaintext configuration files."
              },
              "properties": {
                "tags": ["security", "secret"],
                "cwe": ["CWE-260"]
              }
            },
            {
              "id": "blank-password-config-005",
              "shortDescription": {
                "text": "Empty or blank password in configuration"
              },
              "fullDescription": {
                "text": "An empty password value in the configuration allows authentication bypass or unauthorized access."
              },
              "help": {
                "text": "Ensure all authentication mechanisms require non-empty passwords."
              },
              "properties": {
                "tags": ["security", "secret"],
                "cwe": ["CWE-258"]
              }
            },
            {
              "id": "password-in-asp-config-006",
              "shortDescription": {
                "text": "Password stored in ASP.NET configuration"
              },
              "fullDescription": {
                "text": "Sensitive credentials are stored in an ASP.NET configuration file without proper encryption."
              },
              "help": {
                "text": "Use ASP.NET's protected configuration feature to encrypt sensitive sections."
              },
              "properties": {
                "tags": ["security", "secret"],
                "cwe": ["CWE-13"]
              }
            },
            {
              "id": "credentials-in-j2ee-config-007",
              "shortDescription": {
                "text": "Credentials exposed in J2EE configuration"
              },
              "fullDescription": {
                "text": "J2EE application configuration contains plaintext credentials that should be stored in a secure credential store."
              },
              "help": {
                "text": "Use JNDI or application server credential stores instead of plaintext configuration."
              },
              "properties": {
                "tags": ["security", "secret"],
                "cwe": ["CWE-555"]
              }
            },
            {
              "id": "plaintext-password-storage-008",
              "shortDescription": {
                "text": "Password stored in plaintext format"
              },
              "fullDescription": {
                "text": "Passwords are stored without hashing or encryption, allowing direct exposure if the storage medium is compromised."
              },
              "help": {
                "text": "Always hash passwords using strong algorithms like bcrypt, scrypt, or Argon2."
              },
              "properties": {
                "tags": ["security", "secret"],
                "cwe": ["CWE-256"]
              }
            },
            {
              "id": "recoverable-password-009",
              "shortDescription": {
                "text": "Password stored in recoverable format"
              },
              "fullDescription": {
                "text": "Passwords are stored using reversible encryption rather than one-way hashing, making them recoverable by attackers."
              },
              "help": {
                "text": "Use one-way cryptographic hashing instead of reversible encryption for password storage."
              },
              "properties": {
                "tags": ["security", "secret"],
                "cwe": ["CWE-257"]
              }
            },
            {
              "id": "weak-password-encoding-010",
              "shortDescription": {
                "text": "Password stored with weak encoding"
              },
              "fullDescription": {
                "text": "Passwords are encoded using a weak or trivially reversible scheme such as Base64 instead of a proper cryptographic hash."
              },
              "help": {
                "text": "Replace weak encoding with strong cryptographic hashing algorithms."
              },
              "properties": {
                "tags": ["security", "secret"],
                "cwe": ["CWE-261"]
              }
            },
            {
              "id": "cleartext-cookie-credentials-011",
              "shortDescription": {
                "text": "Sensitive information stored in cleartext cookie"
              },
              "fullDescription": {
                "text": "Credentials or sensitive tokens are stored in browser cookies without encryption, exposing them to interception."
              },
              "help": {
                "text": "Encrypt cookie values and use Secure and HttpOnly flags."
              },
              "properties": {
                "tags": ["security", "secret"],
                "cwe": ["CWE-315"]
              }
            },
            {
              "id": "cleartext-memory-credentials-012",
              "shortDescription": {
                "text": "Credentials stored in cleartext in memory"
              },
              "fullDescription": {
                "text": "Sensitive credentials remain in process memory in cleartext, vulnerable to memory dump attacks."
              },
              "help": {
                "text": "Zero out sensitive data from memory after use and avoid storing credentials longer than necessary."
              },
              "properties": {
                "tags": ["security", "secret"],
                "cwe": ["CWE-316"]
              }
            },
            {
              "id": "insecure-local-storage-013",
              "shortDescription": {
                "text": "Sensitive data stored insecurely on device"
              },
              "fullDescription": {
                "text": "Credentials or secrets are stored in local device storage without encryption, accessible to other applications."
              },
              "help": {
                "text": "Use platform-specific secure storage (Keychain, KeyStore) for sensitive data."
              },
              "properties": {
                "tags": ["security", "secret"],
                "cwe": ["CWE-921"]
              }
            },
            {
              "id": "insecure-storage-mechanism-014",
              "shortDescription": {
                "text": "Sensitive data stored with insufficient access controls"
              },
              "fullDescription": {
                "text": "Secrets are stored in a location or mechanism that does not have adequate access controls, allowing unauthorized retrieval."
              },
              "help": {
                "text": "Restrict file permissions and use encrypted storage for sensitive data."
              },
              "properties": {
                "tags": ["security", "secret"],
                "cwe": ["CWE-922"]
              }
            },
            {
              "id": "secret-in-source-015",
              "shortDescription": {
                "text": "Sensitive information included in source code"
              },
              "fullDescription": {
                "text": "API keys, tokens, or other secrets are embedded directly in source code files committed to version control."
              },
              "help": {
                "text": "Use .gitignore, pre-commit hooks, and secret scanning to prevent secrets from being committed."
              },
              "properties": {
                "tags": ["security", "secret"],
                "cwe": ["CWE-540"]
              }
            },
            {
              "id": "credentials-unprotected-channel-016",
              "shortDescription": {
                "text": "Credentials transmitted over unprotected channel"
              },
              "fullDescription": {
                "text": "Login credentials are sent over an unencrypted channel, making them susceptible to interception via network sniffing."
              },
              "help": {
                "text": "Always transmit credentials over TLS-encrypted connections."
              },
              "properties": {
                "tags": ["security", "secret"],
                "cwe": ["CWE-523"]
              }
            }
          ]
        }
